{
  "datasets": [
    {
      "name": "de070bb5",
      "displayName": "Ventas del mes",
      "queryLines": [
        "--ventas del mes\r\n",
        "SELECT\r\n",
        "  df.anio,\r\n",
        "  df.mes,\r\n",
        "  dc.full_name,\r\n",
        "  SUM(f.monto_total) AS ventas_mes\r\n",
        "FROM proyecto_final.gold.fact_ventas f\r\n",
        "JOIN proyecto_final.gold.dim_cliente dc ON f.customer_key = dc.customer_key\r\n",
        "JOIN proyecto_final.gold.dim_fecha df ON f.date_key = df.date_key\r\n",
        "GROUP BY df.anio, df.mes, dc.full_name;"
      ]
    },
    {
      "name": "productos_mas_vendidos",
      "displayName": "Productos Más Vendidos",
      "queryLines": [
        "SELECT\n",
        "  dpd.nombre_producto,\n",
        "  dpd.categoria,\n",
        "  SUM(f.cantidad) AS total_cantidad_vendida,\n",
        "  SUM(f.monto_total) AS total_ventas,\n",
        "  COUNT(DISTINCT f.order_id) AS total_ordenes,\n",
        "  AVG(f.precio_unitario) AS precio_promedio\n",
        "FROM\n",
        "  proyecto_final.gold.fact_ventas f\n",
        "    JOIN proyecto_final.gold.dim_producto dpd\n",
        "      ON f.product_key = dpd.product_key\n",
        "GROUP BY\n",
        "  dpd.nombre_producto,\n",
        "  dpd.categoria\n",
        "ORDER BY\n",
        "  total_cantidad_vendida DESC"
      ]
    }
  ],
